# ==============================================================================
# Database Configuration (Supabase PostgreSQL + pgvector)
# ==============================================================================
# For Render / Cloud platforms (requires IPv4): Use Supabase Connection Pooler (Session/Transaction mode):
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR_PROJECT_REF]:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# For Local Development / Direct Connection (IPv6 or IPv4):
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ==============================================================================
# Application & Security Settings
# ==============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
JWT_SECRET=generate_a_secure_random_32_character_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of additional allowed frontend origins (e.g. production Vercel domain):
# CORS_ORIGINS=https://sync-ai-productivity.vercel.app,https://your-custom-domain.com

# ==============================================================================
# Supabase Storage & Client Configuration
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
MAX_UPLOAD_SIZE=10485760 # 10MB in bytes

# ==============================================================================
# RAG: Chunking & FastEmbed Vector Embeddings
# ==============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=fastembed # options: fastembed, openai, mock
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RAG_MAX_DISTANCE=0.45
# OPENAI_API_KEY=your-openai-key-if-using-openai-embeddings

# ==============================================================================
# Conversational RAG & AI Productivity (LLM)
# ==============================================================================
LLM_PROVIDER=groq # options: groq, openai, mock
# Provide either GROQ_API_KEY or LLM_API_KEY:
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_API_KEY=your_openai_or_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1 # Defaults to Groq when provider is groq, or OpenAI
LLM_MODEL=openai/gpt-oss-120b # Groq: openai/gpt-oss-120b; OpenAI: gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=30.0

# ==============================================================================
# Video Conferencing & Audio Transcription (LiveKit + Groq Whisper)
# ==============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here
# Groq Whisper speech-to-text model (default: whisper-large-v3-turbo)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_API_KEY is shared with the LLM provider or configured above
# GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Whisper Free-Tier Resilient Queue & Batching Settings
TRANSCRIPTION_BATCH_DURATION_SECONDS=30
TRANSCRIPTION_MAX_RETRIES=3
TRANSCRIPTION_INITIAL_BACKOFF_SECONDS=2.0
TRANSCRIPTION_MAX_BACKOFF_SECONDS=30.0
TRANSCRIPTION_QUEUE_MAX_SIZE=100
TRANSCRIPTION_CONCURRENCY=2
