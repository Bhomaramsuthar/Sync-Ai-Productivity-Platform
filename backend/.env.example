DATABASE_URL=DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
JWT_SECRET=supersecretjwtkey_please_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# RAG & Embeddings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=fastembed # options: fastembed, openai, mock
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RAG_MAX_DISTANCE=0.45
# OPENAI_API_KEY=your-openai-key-if-using-openai-provider
# OPENAI_BASE_URL=https://api.openai.com/v1

# Conversational RAG & LLM Generation (Week 11)
LLM_PROVIDER=groq # options: groq, openai, mock
# LLM_API_KEY=your-llm-api-key (OpenAI, OpenRouter, Groq, or Google AI Studio OpenAI endpoint)
# GROQ_API_KEY=your-groq-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1 # or https://api.openai.com/v1, https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b # Groq: openai/gpt-oss-120b, qwen/qwen3.8-27b; OpenAI: gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=30.0
