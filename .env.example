# ==============================================================================
# AI-Driven Collaboration & Productivity Platform — Environment Variables
# ==============================================================================
# Copy backend variables to backend/.env and frontend variables to frontend/.env
# Do NOT commit actual secrets, API keys, or .env files to version control.

# ------------------------------------------------------------------------------
# Backend Service (FastAPI / Render)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
ENVIRONMENT=production
LOG_LEVEL=INFO
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Supabase Storage & Client
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# CORS Settings (comma-separated allowed frontend production URLs)
CORS_ORIGINS=https://sync-ai-productivity.vercel.app

# RAG & Embeddings (Local FastEmbed CPU)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RAG_MAX_DISTANCE=0.45

# AI Language Model (Groq / OpenAI / Mock)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=30.0

# Video Conferencing & Transcription (LiveKit & Groq Whisper)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ------------------------------------------------------------------------------
# Frontend Application (React + Vite / Vercel)
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings > Environment Variables:
VITE_API_URL=https://ai-productivity-platform-api.onrender.com/api/v1
